<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NorthStar.UI.Pages.DevPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>

        <StackPanel
            Margin="30"
            Spacing="20">

            <TextBlock
                Text="Developer"
                FontSize="28"
                Foreground="{StaticResource NorthStarGreen}" />

            <TextBlock
                x:Name="RuntimeStatusText"
                Text="Runtime: Not running"
                FontSize="16"
                Foreground="{StaticResource NorthStarGreen}" />

            <TextBlock
                x:Name="TrackingStatusText"
                Text="Tracking: Inactive"
                FontSize="16"
                Foreground="{StaticResource NorthStarGreen}" />


            <!-- Pipeline -->
            <Border
                Padding="20"
                BorderThickness="1"
                BorderBrush="{StaticResource NorthStarGreen}">

                <StackPanel
                    Spacing="10">

                    <TextBlock
                        Text="Pipeline"
                        FontSize="22"
                        Foreground="{StaticResource NorthStarGreen}" />

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>


                        <TextBlock
                            Text="Capture"
                            Grid.Row="0"
                            Grid.Column="0" />

                        <TextBlock
                            x:Name="CaptureTimeText"
                            Text="—"
                            Grid.Row="0"
                            Grid.Column="1" />


                        <TextBlock
                            Text="Decode"
                            Grid.Row="1"
                            Grid.Column="0" />

                        <TextBlock
                            x:Name="DecodeTimeText"
                            Text="—"
                            Grid.Row="1"
                            Grid.Column="1" />


                        <TextBlock
                            Text="Conversion"
                            Grid.Row="2"
                            Grid.Column="0" />

                        <TextBlock
                            x:Name="ConversionTimeText"
                            Text="—"
                            Grid.Row="2"
                            Grid.Column="1" />


                        <TextBlock
                            Text="Total"
                            FontWeight="Bold"
                            Grid.Row="3"
                            Grid.Column="0" />

                        <TextBlock
                            x:Name="PipelineTotalTimeText"
                            Text="—"
                            FontWeight="Bold"
                            Grid.Row="3"
                            Grid.Column="1" />

                    </Grid>

                </StackPanel>

            </Border>


            <!-- Pose model -->
            <Border
                Padding="20"
                BorderThickness="1"
                BorderBrush="{StaticResource NorthStarGreen}">

                <StackPanel
                    Spacing="10">

                    <TextBlock
                        Text="Pose Model"
                        FontSize="22"
                        Foreground="{StaticResource NorthStarGreen}" />

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>


                        <TextBlock
                            Text="Preprocessing"
                            Grid.Row="0"
                            Grid.Column="0" />

                        <TextBlock
                            x:Name="PreprocessingTimeText"
                            Text="—"
                            Grid.Row="0"
                            Grid.Column="1" />


                        <TextBlock
                            Text="Inference"
                            Grid.Row="1"
                            Grid.Column="0" />

                        <TextBlock
                            x:Name="InferenceTimeText"
                            Text="—"
                            Grid.Row="1"
                            Grid.Column="1" />


                        <TextBlock
                            Text="Pose Decode"
                            Grid.Row="2"
                            Grid.Column="0" />

                        <TextBlock
                            x:Name="PoseDecodeTimeText"
                            Text="—"
                            Grid.Row="2"
                            Grid.Column="1" />


                        <TextBlock
                            Text="Coordinate Transform"
                            Grid.Row="3"
                            Grid.Column="0" />

                        <TextBlock
                            x:Name="CoordinateTransformTimeText"
                            Text="—"
                            Grid.Row="3"
                            Grid.Column="1" />


                        <TextBlock
                            Text="Total"
                            FontWeight="Bold"
                            Grid.Row="4"
                            Grid.Column="0" />

                        <TextBlock
                            x:Name="PoseTotalTimeText"
                            Text="—"
                            FontWeight="Bold"
                            Grid.Row="4"
                            Grid.Column="1" />

                    </Grid>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</Page>