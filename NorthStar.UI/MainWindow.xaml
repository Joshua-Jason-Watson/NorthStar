<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="NorthStar.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NorthStar.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NorthStar">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid
        Background="{StaticResource NorthStarDarkGreen}"
        RequestedTheme="Dark">

        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border
            Grid.Row="0"
            Background="{StaticResource NorthStarSurface}"
            BorderBrush="{StaticResource NorthStarBorder}"
            BorderThickness="0,0,0,1">

            <Grid Margin="24,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">

                    <Border
                        Width="8"
                        Height="34"
                        Background="{StaticResource NorthStarGreen}"
                        CornerRadius="3"/>

                    <StackPanel Spacing="0">

                        <TextBlock
                            Text="NORTHSTAR"
                            FontSize="24"
                            FontWeight="SemiBold"
                            CharacterSpacing="100"
                            Foreground="{StaticResource NorthStarGreen}"/>

                        <TextBlock
                            Text="REAL-TIME TRACKING PLATFORM"
                            FontSize="10"
                            CharacterSpacing="120"
                            Foreground="{StaticResource NorthStarSecondaryText}"/>

                    </StackPanel>

                </StackPanel>

                <Button
                    x:Name="DevButton"
                    Grid.Column="1"
                    Content="DEV TOOLS"
                    Style="{StaticResource NorthStarSubtleButton}"
                    VerticalAlignment="Center"
                    Click="DevButton_Click"/>

            </Grid>

        </Border>


        <!-- MAIN VIEW -->

        <Grid
            x:Name="MainView"
            Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- CONTROL PANEL -->

            <Border
                Grid.Column="0"
                Margin="20,18,10,18"
                Padding="18"
                Background="{StaticResource NorthStarSurface}"
                BorderBrush="{StaticResource NorthStarBorder}"
                BorderThickness="1"
                CornerRadius="8">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Spacing="16">

                        <StackPanel Spacing="4">

                            <TextBlock
                                Text="CAMERA CONFIGURATION"
                                FontSize="16"
                                FontWeight="SemiBold"
                                CharacterSpacing="65"
                                Foreground="{StaticResource NorthStarGreen}"/>

                            <TextBlock
                                Text="Configure your capture device"
                                FontSize="12"
                                Foreground="{StaticResource NorthStarSecondaryText}"/>

                        </StackPanel>

                        <Border
                            Height="1"
                            Background="{StaticResource NorthStarBorder}"/>


                        <!-- CAMERA -->

                        <StackPanel Spacing="6">

                            <TextBlock
                                Text="CAMERA"
                                FontSize="11"
                                FontWeight="SemiBold"
                                CharacterSpacing="90"
                                Foreground="{StaticResource NorthStarSecondaryText}"/>

                            <ComboBox
                                x:Name="CameraSelector"
                                PlaceholderText="Select camera"
                                PlaceholderForeground="{StaticResource NorthStarSecondaryText}"
                                DisplayMemberPath="Name"
                                Style="{StaticResource NorthStarComboBoxStyle}"
                                SelectionChanged="CameraSelector_SelectionChanged"/>

                        </StackPanel>


                        <!-- RESOLUTION -->

                        <StackPanel Spacing="6">

                            <TextBlock
                                Text="RESOLUTION"
                                FontSize="11"
                                FontWeight="SemiBold"
                                CharacterSpacing="90"
                                Foreground="{StaticResource NorthStarSecondaryText}"/>

                            <ComboBox
                                x:Name="ResolutionSelector"
                                PlaceholderText="Select resolution"
                                PlaceholderForeground="{StaticResource NorthStarSecondaryText}"
                                Style="{StaticResource NorthStarComboBoxStyle}"
                                SelectionChanged="ResolutionSelector_SelectionChanged"/>

                        </StackPanel>


                        <!-- FRAME RATE -->

                        <StackPanel Spacing="6">

                            <TextBlock
                                Text="FRAME RATE"
                                FontSize="11"
                                FontWeight="SemiBold"
                                CharacterSpacing="90"
                                Foreground="{StaticResource NorthStarSecondaryText}"/>

                            <ComboBox
                                x:Name="FrameRateSelector"
                                PlaceholderText="Select frame rate"
                                PlaceholderForeground="{StaticResource NorthStarSecondaryText}"
                                Style="{StaticResource NorthStarComboBoxStyle}"
                                SelectionChanged="FrameRateSelector_SelectionChanged"/>

                        </StackPanel>


                        <!-- PIXEL FORMAT -->

                        <StackPanel Spacing="6">

                            <TextBlock
                                Text="PIXEL FORMAT"
                                FontSize="11"
                                FontWeight="SemiBold"
                                CharacterSpacing="90"
                                Foreground="{StaticResource NorthStarSecondaryText}"/>

                            <ComboBox
                                x:Name="FormatSelector"
                                PlaceholderText="Select format"
                                PlaceholderForeground="{StaticResource NorthStarSecondaryText}"
                                Style="{StaticResource NorthStarComboBoxStyle}"
                                SelectionChanged="FormatSelector_SelectionChanged"/>

                        </StackPanel>


                        <Border
                            Height="1"
                            Background="{StaticResource NorthStarBorder}"
                            Margin="0,2,0,2"/>


                        <!-- OPERATIONS -->

                        <StackPanel Spacing="8">

                            <TextBlock
                                Text="CAMERA OPERATIONS"
                                FontSize="11"
                                FontWeight="SemiBold"
                                CharacterSpacing="90"
                                Foreground="{StaticResource NorthStarSecondaryText}"/>

                            <Button
                                x:Name="StartPreviewButton"
                                Content="START PREVIEW"
                                Style="{StaticResource NorthStarPrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Click="StartPreviewButton_Click"/>

                            <Button
                                x:Name="StartTrackingButton"
                                Content="START TRACKING"
                                Style="{StaticResource NorthStarSecondaryButton}"
                                HorizontalAlignment="Stretch"
                                Click="StartTrackingButton_Click"/>

                        </StackPanel>

                    </StackPanel>

                </ScrollViewer>

            </Border>


            <!-- PREVIEW PANEL -->

            <Border
                Grid.Column="1"
                Margin="10,18,20,18"
                Background="{StaticResource NorthStarSurface}"
                BorderBrush="{StaticResource NorthStarBorder}"
                BorderThickness="1"
                CornerRadius="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- PREVIEW HEADER -->

                    <Border
                        Grid.Row="0"
                        Background="{StaticResource NorthStarSurfaceElevated}"
                        BorderBrush="{StaticResource NorthStarBorder}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0">

                        <Grid Margin="18,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">

                                <Border
                                    Width="7"
                                    Height="7"
                                    CornerRadius="4"
                                    Background="{StaticResource NorthStarGreen}"/>

                                <TextBlock
                                    Text="CAMERA PREVIEW"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    CharacterSpacing="80"
                                    Foreground="{StaticResource NorthStarText}"
                                    VerticalAlignment="Center"/>

                            </StackPanel>


                            <!-- FPS -->

                            <Border
                                Grid.Column="1"
                                Background="{StaticResource NorthStarMagentaSurface}"
                                BorderBrush="{StaticResource NorthStarMagentaBorder}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10,5"
                                VerticalAlignment="Center">

                                <TextBlock
                                    x:Name="FpsText"
                                    Text="FPS: 0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    CharacterSpacing="30"
                                    Foreground="{StaticResource NorthStarAccent}"/>

                            </Border>

                        </Grid>

                    </Border>


                    <!-- PREVIEW CONTENT -->

                    <Grid
                        Grid.Row="1"
                        Background="#090F09">

                        <Image
                            x:Name="PreviewImage"
                            Stretch="Uniform"/>

                        <Canvas
                            x:Name="TrackingOverlay"
                            IsHitTestVisible="False"/>

                    </Grid>

                </Grid>

            </Border>

        </Grid>


        <!-- DEVELOPER PAGE -->

        <Frame
            x:Name="DevFrame"
            Grid.Row="1"
            Visibility="Collapsed"/>

    </Grid>

</Window>
